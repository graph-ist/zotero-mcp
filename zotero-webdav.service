[Unit]
Description=Zotero WebDAV (rclone)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zotero-webdav/htpasswd

[Service]
User=zotero-dav
Group=zotero-dav
ExecStart=/usr/bin/rclone serve webdav /srv/zotero-webdav --addr 0.0.0.0:8090 --htpasswd /etc/zotero-webdav/htpasswd --realm zotero --config /dev/null
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/zotero-webdav
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Reachable only from this host, the home LAN and the tailnet
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8 ::1 192.168.178.0/24 100.64.0.0/10

[Install]
WantedBy=multi-user.target
