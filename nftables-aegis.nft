table inet aegis
delete table inet aegis
table inet aegis {
  chain input {
    type filter hook input priority filter + 10; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    iifname "tailscale0" accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp dport 41641 accept
    udp dport 68 accept
    udp dport 546 accept
    iifname { "eth0", "wlan0" } ip saddr 192.168.178.0/24 tcp dport 22 accept
    iifname { "eth0", "wlan0" } ip saddr 192.168.178.0/24 tcp dport 8090 accept
    iifname { "eth0", "wlan0" } ip saddr 192.168.178.0/24 meta l4proto { tcp, udp } th dport 53 accept
  }
}
